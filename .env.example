# ==============================================================================
# BCA Project RAG Assistant — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. Never commit real secrets.
# ==============================================================================

# Application
APP_NAME="BCA RAG Assistant"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure secret key for production using: openssl rand -hex 32
SECRET_KEY="dev-insecure-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Database (PostgreSQL + pgvector)
# Example local setup: postgresql+psycopg://postgres:postgres@localhost:5432/rag_assistant_db
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/rag_assistant_db"

# Storage
STORAGE_DIR="./storage"

# Ollama / Local Models
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="qwen3:4b"
OLLAMA_EMBED_MODEL="qwen3-embedding:0.6b"
EMBEDDING_DIM=1024

# Reranker
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# RAG Retrieval Parameters
RAG_TOP_K_RETRIEVAL=20
RAG_TOP_K_RERANK=5
RRF_K=60
MAX_CONTEXT_TOKENS=2000
