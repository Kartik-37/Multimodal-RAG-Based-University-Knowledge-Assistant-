# ==============================================================================
# RAG Assistant — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. Never commit real secrets.
# Syntax is strictly compatible with pydantic-settings.
# ==============================================================================

# Application
APP_NAME="RAG Assistant"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# CORS Configuration (JSON array of explicit allowed origins; wildcard disallowed with credentials)
CORS_ORIGINS='["http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:8000", "http://127.0.0.1:8000"]'

# Security & Authentication
# In production, SECRET_KEY must be >= 32 characters and cannot use default placeholder.
# Generate in terminal: openssl rand -hex 32
SECRET_KEY="dev-insecure-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql+psycopg://rag_app_user:CHANGE_ME@localhost:5432/rag_assistant_db"
TEST_DATABASE_URL="postgresql+psycopg://rag_app_user:CHANGE_ME@localhost:5432/rag_assistant_test_db"

# Storage & Uploads
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_BYTES=20971520

# Chunking & Token Estimator Parameters
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=50

# Ollama / Local Models
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="qwen3:4b"
OLLAMA_EMBED_MODEL="qwen3-embedding:0.6b"
EMBEDDING_DIM=1024

# LLM Generation Defaults
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=120.0

# Reranker Model (Local HuggingFace CrossEncoder)
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANK_BATCH_SIZE=32

# RAG Retrieval Parameters
RAG_TOP_K_RETRIEVAL=20
RAG_TOP_K_RERANK=5
RRF_K=60
MAX_CONTEXT_TOKENS=2000

# PostgreSQL Lexical Full-Text Search Configuration
LEXICAL_LANGUAGE="english"
LEXICAL_TOP_K=20
LEXICAL_MAX_QUERY_LENGTH=1000

# Grounding & Citation Validation Parameters (Step 14)
GROUNDING_MIN_OVERLAP_THRESHOLD=0.5
GROUNDING_MAX_ANSWER_LENGTH=10000
GROUNDING_MAX_CLAIMS_PER_ANSWER=100
GROUNDING_MAX_CITATIONS_PER_ANSWER=50
GROUNDING_MAX_EVIDENCE_ITEMS=20

# Rate Limiting & Abuse Protection Configuration (Step 18)
RATE_LIMIT_ENABLED=true
TRUSTED_PROXIES='[]'
RATE_LIMIT_STORAGE_TYPE="postgres"

# Rate Limiting Policies: Requests per Window (Seconds)
RATE_LIMIT_LOGIN_MAX_REQUESTS=20
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX_REQUESTS=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_MAX_REQUESTS=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_RETRIEVAL_MAX_REQUESTS=60
RATE_LIMIT_RETRIEVAL_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_INDEXING_MAX_REQUESTS=20
RATE_LIMIT_INDEXING_WINDOW_SECONDS=60

# Rate Limiting Security Failure Policies
RATE_LIMIT_AUTH_FAIL_CLOSED=true
RATE_LIMIT_EXPENSIVE_FAIL_CLOSED=false
